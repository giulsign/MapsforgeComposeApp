package it.fourSTL.PositionMarker

import android.Manifest
import android.app.Notification
import android.app.NotificationChannel
import android.app.NotificationManager
import android.app.Service
import android.content.Context
import android.content.Intent
import android.content.pm.PackageManager
import android.location.Location
import android.os.Binder
import android.os.Build
import android.os.IBinder
import android.util.Log
import androidx.core.app.ActivityCompat
import androidx.core.app.NotificationCompat
import com.google.android.gms.location.*
import kotlinx.coroutines.*
import kotlinx.coroutines.flow.MutableStateFlow
import kotlinx.coroutines.flow.StateFlow
import kotlinx.serialization.Serializable
import kotlinx.serialization.encodeToString
import kotlinx.serialization.decodeFromString
import kotlinx.serialization.json.Json
import okhttp3.*
import okhttp3.MediaType.Companion.toMediaType
import okhttp3.RequestBody.Companion.toRequestBody
import java.io.IOException
import java.net.InetAddress
import java.net.NetworkInterface
import java.util.concurrent.TimeUnit
import org.java_websocket.WebSocket
import org.java_websocket.handshake.ClientHandshake
import org.java_websocket.server.WebSocketServer
import java.net.InetSocketAddress

class LocationSharingService : Service() {

    companion object {
        private const val TAG = "LocationSharingService"

        // Intent
        const val ACTION_START_HOST = "it.fourSTL.PositionMarker.START_HOST"
        const val ACTION_START_GUEST = "it.fourSTL.PositionMarker.START_GUEST"
        const val ACTION_STOP = "it.fourSTL.PositionMarker.STOP"

        // Extras
        const val EXTRA_HOST_ADDRESS = "host_address"

        // Configuration
        private const val NOTIFICATION_ID = 1001
        private const val CHANNEL_ID = "location_sharing_channel"
        private const val LOCATION_UPDATE_INTERVAL = 3000L // 3 seconds
        private const val WEBSOCKET_PORT = 8765
        private const val MEMBER_TIMEOUT_MS = 30_000L // 30 seconds
        private const val PING_INTERVAL_MS = 10_000L // 10 seconds
    }

    private val binder = LocalBinder()
    private val json = Json { ignoreUnknownKeys = true }

    // Managers
    private lateinit var groupManager: GroupManager
    private lateinit var fusedLocationClient: FusedLocationProviderClient

    // Coroutine scope
    private val serviceScope = CoroutineScope(Dispatchers.IO + SupervisorJob())

    // WebSocket
    private var webSocketServer: OkHttpWebSocketServer? = null
    //private var webSocketClient: WebSocket? = null
    private var webSocketClient: okhttp3.WebSocket? = null
    private val okHttpClient = OkHttpClient.Builder()
        .pingInterval(PING_INTERVAL_MS, TimeUnit.MILLISECONDS)
        .readTimeout(30, TimeUnit.SECONDS)
        .build()

    // States
    private var isHost = false
    private var isRunning = false
    private var lastLocation: Location? = null

    private val _serviceState = MutableStateFlow<ServiceState>(ServiceState.Idle)
    val serviceState: StateFlow<ServiceState> = _serviceState

    private val _connectedMembers = MutableStateFlow<List<GroupMember>>(emptyList())
    val connectedMembers: StateFlow<List<GroupMember>> = _connectedMembers

    // Location callback
    private val locationCallback = object : LocationCallback() {
        override fun onLocationResult(result: LocationResult) {
            result.lastLocation?.let { location ->
                lastLocation = location
                broadcastLocation(location)
            }
        }
    }

    // ==================== DATA CLASSES ====================

    sealed class ServiceState {
        object Idle : ServiceState()
        object Starting : ServiceState()
        data class HostRunning(val ipAddress: String, val port: Int) : ServiceState()
        data class GuestRunning(val hostAddress: String) : ServiceState()
        data class Error(val message: String) : ServiceState()
    }

    @Serializable
    data class LocationMessage(
        val type: String, // "LOCATION", "JOIN", "LEAVE", "PING", "PONG"
        val deviceId: String,
        val deviceName: String? = null,
        val groupId: String? = null,
        val latitude: Double? = null,
        val longitude: Double? = null,
        val altitude: Double? = null,
        val timestamp: Long = System.currentTimeMillis(),
        val encryptedPayload: String? = null,
        val iv: String? = null
    )

    // ==================== SERVICE LIFECYCLE ====================

    override fun onCreate() {
        super.onCreate()
        groupManager = GroupManager(this)
        fusedLocationClient = LocationServices.getFusedLocationProviderClient(this)
        Log.d(TAG, "Service created")
    }

    override fun onStartCommand(intent: Intent?, flags: Int, startId: Int): Int {
        when (intent?.action) {
            ACTION_START_HOST -> startAsHost()
            ACTION_START_GUEST -> {
                val hostAddress = intent.getStringExtra(EXTRA_HOST_ADDRESS)
                if (hostAddress != null) {
                    startAsGuest(hostAddress)
                } else {
                    Log.e(TAG, "Missing host address")
                    _serviceState.value = ServiceState.Error("Missing host address")
                }
            }
            ACTION_STOP -> stopService()
        }

        return START_STICKY
    }

    override fun onBind(intent: Intent?): IBinder {
        return binder
    }

    override fun onDestroy() {
        stopService()
        super.onDestroy()
    }

    inner class LocalBinder : Binder() {
        fun getService(): LocationSharingService = this@LocationSharingService
    }

    // ==================== START AS HOST ====================

    private fun startAsHost() {
        if (isRunning) {
            Log.w(TAG, "Service already running")
            return
        }

        val group = groupManager.getActiveGroup()
        if (group == null) {
            Log.e(TAG, "No active group")
            _serviceState.value = ServiceState.Error("No active group")
            return
        }

        if (!group.isHost) {
            Log.e(TAG, "Not a host of the group")
            _serviceState.value = ServiceState.Error("You are not the host")
            return
        }

        isHost = true
        _serviceState.value = ServiceState.Starting

        startForeground(NOTIFICATION_ID, createNotification("Starting as host..."))

        serviceScope.launch {
            try {
                // Start WebSocket Server
                val ipAddress = getLocalIpAddress()
                webSocketServer = OkHttpWebSocketServer(
                    port = WEBSOCKET_PORT,
                    onMessage = { clientId, message -> handleReceivedMessage(clientId, message) },
                    onClientConnected = { clientId ->
                        Log.d(TAG, "Client connected: $clientId")
                    },
                    onClientDisconnected = { clientId ->
                        Log.d(TAG, "Client disconnected: $clientId")
                        handleClientDisconnected(clientId)
                    }
                )

                webSocketServer?.start()

                // Upload group address
                group.hostAddress = "$ipAddress:$WEBSOCKET_PORT"
                groupManager.setActiveGroup(group)

                _serviceState.value = ServiceState.HostRunning(ipAddress, WEBSOCKET_PORT)

                // Uploader notifications
                val notification = createNotification(
                    "Sharing as HOST\n$ipAddress:$WEBSOCKET_PORT"
                )
                val notificationManager = getSystemService(Context.NOTIFICATION_SERVICE) as NotificationManager
                notificationManager.notify(NOTIFICATION_ID, notification)

                // Starts
                startLocationUpdates()

                // Starts controll
                startMemberTimeoutChecker()

                isRunning = true
                Log.d(TAG, "Started as host on $ipAddress:$WEBSOCKET_PORT")

            } catch (e: Exception) {
                Log.e(TAG, "Failed to start as host", e)
                _serviceState.value = ServiceState.Error("Failed to start: ${e.message}")
                stopSelf()
            }
        }
    }

    // ==================== START AS GUEST ====================

    private fun startAsGuest(hostAddress: String) {
        if (isRunning) {
            Log.w(TAG, "Service already running")
            return
        }

        val group = groupManager.getActiveGroup()
        if (group == null) {
            Log.e(TAG, "No active group")
            _serviceState.value = ServiceState.Error("No active group")
            return
        }

        isHost = false
        _serviceState.value = ServiceState.Starting

        startForeground(NOTIFICATION_ID, createNotification("Connecting to host..."))

        serviceScope.launch {
            try {
                val wsUrl = "ws://$hostAddress"
                val request = Request.Builder()
                    .url(wsUrl)
                    .build()

                // ✅ Ora il tipo corrisponde
                webSocketClient = okHttpClient.newWebSocket(request, object : WebSocketListener() {
                    override fun onOpen(webSocket: okhttp3.WebSocket, response: Response) {
                        Log.d(TAG, "WebSocket connected to host")
                        sendJoinMessage()
                        _serviceState.value = ServiceState.GuestRunning(hostAddress)

                        val notification = createNotification("Connected to HOST\n$hostAddress")
                        val notificationManager = getSystemService(NOTIFICATION_SERVICE) as NotificationManager
                        notificationManager.notify(NOTIFICATION_ID, notification)

                        startLocationUpdates()
                        isRunning = true
                    }

                    override fun onMessage(webSocket: okhttp3.WebSocket, text: String) {
                        handleReceivedMessage(null, text)
                    }

                    override fun onFailure(webSocket: okhttp3.WebSocket, t: Throwable, response: Response?) {
                        Log.e(TAG, "WebSocket failure", t)
                        _serviceState.value = ServiceState.Error("Connection failed: ${t.message}")
                        stopSelf()
                    }

                    override fun onClosed(webSocket: okhttp3.WebSocket, code: Int, reason: String) {
                        Log.d(TAG, "WebSocket closed: $reason")
                        if (isRunning) {
                            _serviceState.value = ServiceState.Error("Connection closed")
                            stopSelf()
                        }
                    }
                })

            } catch (e: Exception) {
                Log.e(TAG, "Failed to connect as guest", e)
                _serviceState.value = ServiceState.Error("Connection failed: ${e.message}")
                stopSelf()
            }
        }
    }

    // ==================== LOCATION UPDATES ====================

    private fun startLocationUpdates() {
        if (ActivityCompat.checkSelfPermission(
                this,
                Manifest.permission.ACCESS_FINE_LOCATION
            ) != PackageManager.PERMISSION_GRANTED
        ) {
            Log.e(TAG, "Missing location permission")
            return
        }

        val locationRequest = LocationRequest.Builder(
            Priority.PRIORITY_HIGH_ACCURACY,
            LOCATION_UPDATE_INTERVAL
        ).build()

        fusedLocationClient.requestLocationUpdates(
            locationRequest,
            Dispatchers.Main.asExecutor(),
            //serviceScope.coroutineContext.asExecutor(),
            locationCallback
        )

        Log.d(TAG, "Location updates started")
    }

    private fun stopLocationUpdates() {
        fusedLocationClient.removeLocationUpdates(locationCallback)
        Log.d(TAG, "Location updates stopped")
    }

    // ==================== MESSAGE HANDLING ====================

    private fun broadcastLocation(location: Location) {
        val group = groupManager.getActiveGroup() ?: return

        // Aggiorna posizione locale nel GroupManager
        groupManager.updateMemberPosition(
            groupManager.getDeviceId(),
            location.latitude,
            location.longitude
        )

        // Crea messaggio posizione
        val locationMsg = LocationMessage(
            type = "LOCATION",
            deviceId = groupManager.getDeviceId(),
            deviceName = groupManager.getDeviceName(),
            groupId = group.id,
            latitude = location.latitude,
            longitude = location.longitude,
            altitude = location.altitude
        )

        // Cripta il messaggio
        val messageJson = json.encodeToString(locationMsg)
        val encrypted = groupManager.encryptMessage(messageJson)

        if (encrypted != null) {
            val encryptedMsg = LocationMessage(
                type = "LOCATION",
                deviceId = groupManager.getDeviceId(),
                groupId = group.id,
                encryptedPayload = encrypted.payload,
                iv = encrypted.iv
            )

            val encryptedJson = json.encodeToString(encryptedMsg)

            // Invia via WebSocket
            if (isHost) {
                webSocketServer?.broadcast(encryptedJson)
            } else {
                webSocketClient?.send(encryptedJson)
            }
        }
    }

    private fun handleReceivedMessage(clientId: String?, messageJson: String) {
        try {
            val message = json.decodeFromString<LocationMessage>(messageJson)

            // Verifica gruppo
            val group = groupManager.getActiveGroup()
            if (group == null || message.groupId != group.id) {
                Log.w(TAG, "Message from wrong group")
                return
            }

            when (message.type) {
                "LOCATION" -> {
                    // Decripta il messaggio
                    if (message.encryptedPayload != null && message.iv != null) {
                        val encryptedMessage = EncryptedMessage(
                            payload = message.encryptedPayload,
                            iv = message.iv,
                            groupId = message.groupId,
                            deviceId = message.deviceId
                        )

                        val decryptedJson = groupManager.decryptMessage(encryptedMessage)
                        if (decryptedJson != null) {
                            val decryptedMsg = json.decodeFromString<LocationMessage>(decryptedJson)

                            // Aggiorna posizione membro
                            if (decryptedMsg.latitude != null && decryptedMsg.longitude != null) {
                                groupManager.updateMemberPosition(
                                    decryptedMsg.deviceId,
                                    decryptedMsg.latitude,
                                    decryptedMsg.longitude
                                )

                                // Aggiorna lista connessi
                                updateConnectedMembers()
                            }
                        }
                    }

                    // Se siamo host, inoltra agli altri client
                    if (isHost && clientId != null) {
                        webSocketServer?.broadcastExcept(messageJson, clientId)
                    }
                }

                "JOIN" -> {
                    Log.d(TAG, "Member joined: ${message.deviceName}")

                    // Aggiungi membro al gruppo
                    val newMember = GroupMember(
                        deviceId = message.deviceId,
                        deviceName = message.deviceName ?: "Unknown",
                        joinedAt = System.currentTimeMillis(),
                        isOnline = true
                    )
                    groupManager.updateMember(newMember)
                    updateConnectedMembers()

                    // Se siamo host, invia posizione corrente al nuovo membro
                    if (isHost && clientId != null) {
                        lastLocation?.let { loc ->
                            val locationMsg = LocationMessage(
                                type = "LOCATION",
                                deviceId = groupManager.getDeviceId(),
                                deviceName = groupManager.getDeviceName(),
                                groupId = group.id,
                                latitude = loc.latitude,
                                longitude = loc.longitude,
                                altitude = loc.altitude
                            )

                            val msgJson = json.encodeToString(locationMsg)
                            val encrypted = groupManager.encryptMessage(msgJson)

                            if (encrypted != null) {
                                val encryptedMsg = LocationMessage(
                                    type = "LOCATION",
                                    deviceId = groupManager.getDeviceId(),
                                    groupId = group.id,
                                    encryptedPayload = encrypted.payload,
                                    iv = encrypted.iv
                                )
                                webSocketServer?.sendToClient(clientId, json.encodeToString(encryptedMsg))
                            }
                        }
                    }
                }

                "LEAVE" -> {
                    Log.d(TAG, "Member left: ${message.deviceId}")
                    groupManager.removeMember(message.deviceId)
                    updateConnectedMembers()
                }

                "PING" -> {
                    // Rispondi con PONG
                    val pongMsg = LocationMessage(
                        type = "PONG",
                        deviceId = groupManager.getDeviceId(),
                        groupId = group.id
                    )

                    val pongJson = json.encodeToString(pongMsg)
                    if (isHost && clientId != null) {
                        webSocketServer?.sendToClient(clientId, pongJson)
                    } else {
                        webSocketClient?.send(pongJson)
                    }
                }
            }

        } catch (e: Exception) {
            Log.e(TAG, "Failed to handle message", e)
        }
    }

    private fun sendJoinMessage() {
        val group = groupManager.getActiveGroup() ?: return

        val joinMsg = LocationMessage(
            type = "JOIN",
            deviceId = groupManager.getDeviceId(),
            deviceName = groupManager.getDeviceName(),
            groupId = group.id
        )

        val joinJson = json.encodeToString(joinMsg)
        webSocketClient?.send(joinJson)
    }

    private fun handleClientDisconnected(clientId: String) {
        // Marca il membro come offline
        val group = groupManager.getActiveGroup() ?: return
        val member = group.members.find { it.deviceId == clientId }

        if (member != null) {
            member.isOnline = false
            groupManager.updateMember(member)
            updateConnectedMembers()
        }
    }

    // ==================== MEMBER MANAGEMENT ====================

    private fun updateConnectedMembers() {
        val group = groupManager.getActiveGroup()
        if (group != null) {
            _connectedMembers.value = group.members.filter { it.isOnline }
        }
    }

    private fun startMemberTimeoutChecker() {
        serviceScope.launch {
            while (isRunning && isHost) {
                delay(5000) // Controlla ogni 5 secondi
                groupManager.checkMemberTimeouts()
                updateConnectedMembers()
            }
        }
    }

    // ==================== NETWORK UTILS ====================

    private fun getLocalIpAddress(): String {
        try {
            val interfaces = NetworkInterface.getNetworkInterfaces()
            while (interfaces.hasMoreElements()) {
                val networkInterface = interfaces.nextElement()
                val addresses = networkInterface.inetAddresses

                while (addresses.hasMoreElements()) {
                    val address = addresses.nextElement()

                    if (!address.isLoopbackAddress && address is java.net.Inet4Address) {
                        return address.hostAddress ?: "0.0.0.0"
                    }
                }
            }
        } catch (e: Exception) {
            Log.e(TAG, "Failed to get IP address", e)
        }

        return "0.0.0.0"
    }

    // ==================== NOTIFICATION ====================

    private fun createNotification(contentText: String): Notification {
        createNotificationChannel()

        return NotificationCompat.Builder(this, CHANNEL_ID)
            .setContentTitle("GPS Position Sharing")
            .setContentText(contentText)
            .setSmallIcon(R.drawable.ic_marker_blue)
            .setPriority(NotificationCompat.PRIORITY_LOW)
            .setOngoing(true)
            .build()
    }

    private fun createNotificationChannel() {
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
            val channel = NotificationChannel(
                CHANNEL_ID,
                "Location Sharing",
                NotificationManager.IMPORTANCE_LOW
            ).apply {
                description = "Shows when sharing GPS position with group"
            }

            val notificationManager = getSystemService(Context.NOTIFICATION_SERVICE) as NotificationManager
            notificationManager.createNotificationChannel(channel)
        }
    }

    // ==================== STOP SERVICE ====================

    private fun stopService() {
        if (!isRunning) return

        // Invia messaggio LEAVE
        val group = groupManager.getActiveGroup()
        if (group != null) {
            val leaveMsg = LocationMessage(
                type = "LEAVE",
                deviceId = groupManager.getDeviceId(),
                groupId = group.id
            )

            val leaveJson = json.encodeToString(leaveMsg)

            if (isHost) {
                webSocketServer?.broadcast(leaveJson)
            } else {
                webSocketClient?.send(leaveJson)
            }
        }

        // Chiudi connessioni
        webSocketServer?.stop()
        webSocketClient?.close(1000, "Service stopped")

        // Ferma aggiornamenti GPS
        stopLocationUpdates()

        // Cancella coroutines
        serviceScope.cancel()

        isRunning = false
        _serviceState.value = ServiceState.Idle

        stopForeground(true)
        stopSelf()

        Log.d(TAG, "Service stopped")
    }
}

// ==================== WEBSOCKET SERVER (HOST) ====================

class OkHttpWebSocketServer(
    private val port: Int,
    private val onMessage: (clientId: String, message: String) -> Unit,
    private val onClientConnected: (clientId: String) -> Unit,
    private val onClientDisconnected: (clientId: String) -> Unit
) : WebSocketServer(InetSocketAddress(port)) {

    private val clients = mutableMapOf<String, WebSocket>()

    override fun onOpen(conn: WebSocket, handshake: ClientHandshake) {
        val clientId = conn.remoteSocketAddress.toString()
        clients[clientId] = conn
        onClientConnected(clientId)
        Log.d("WebSocketServer", "Client connected: $clientId")
    }

    override fun onClose(conn: WebSocket, code: Int, reason: String, remote: Boolean) {
        val clientId = conn.remoteSocketAddress.toString()
        clients.remove(clientId)
        onClientDisconnected(clientId)
        Log.d("WebSocketServer", "Client disconnected: $clientId")
    }

    override fun onMessage(conn: WebSocket, message: String) {
        val clientId = conn.remoteSocketAddress.toString()
        onMessage(clientId, message)
    }

    override fun onError(conn: WebSocket?, ex: Exception) {
        Log.e("WebSocketServer", "WebSocket error", ex)
    }

    override fun onStart() {
        Log.d("WebSocketServer", "Server started on port $port")
    }

    override fun broadcast(message: String) {
        clients.values.forEach { it.send(message) }
    }

    fun broadcastExcept(message: String, excludeClientId: String) {
        clients.filterKeys { it != excludeClientId }.values.forEach { it.send(message) }
    }

    fun sendToClient(clientId: String, message: String) {
        clients[clientId]?.send(message)
    }
}