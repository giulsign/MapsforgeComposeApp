<?xml version="1.0" encoding="UTF-8"?>
<rendertheme xmlns="http://mapsforge.org/renderTheme"
    version="5"
    map-background="#E8E4D9"
    map-background-outside="#D4D0C5"
    base-stroke-width="1.0"
    base-text-size="11.0">

    <!-- ========================================================================== -->
    <!--                         NATURAL AREA - BASE LAYER                        -->
    <!-- ========================================================================== -->

    <rule e="way" k="natural" v="bare_rock|scree|shingle|sand">
        <area fill="#D4CABC"/>
    </rule>
    <rule e="way" k="landuse" v="grass|meadow|farmland|village_green">
        <area fill="#D5E3C5"/>
    </rule>
    <rule e="way" k="natural" v="grassland">
        <area fill="#D5E3C5"/>
    </rule>
    <rule e="way" k="landuse" v="farmland">
        <area fill="#E8ECDB"/>
    </rule>
    <rule e="way" k="natural" v="scrub|heath">
        <area fill="#C8D8B0"/>
    </rule>
    <rule e="way" k="landuse" v="forest">
        <area fill="#9FB885"/>
    </rule>
    <rule e="way" k="natural" v="wood">
        <area fill="#A4BD8A"/>
    </rule>
    <rule e="way" k="landuse" v="orchard|vineyard">
        <area fill="#B5D1A0"/>
    </rule>

    <!-- ========================================================================== -->
    <!--                              WATER AREA                               -->
    <!-- ========================================================================== -->

    <rule e="way" k="natural" v="coastline" zoom-min="6">
        <area fill="#A6C5DA"/>
    </rule>
    <rule e="way" k="natural" v="coastline" zoom-min="12">
        <line stroke="#8AACCA" stroke-width="1.2"/>
    </rule>
    <rule e="way" k="natural" v="water">
        <area fill="#B8D4E8"/>
    </rule>
    <rule e="way" k="landuse" v="reservoir|basin">
        <area fill="#B8D4E8"/>
    </rule>
    <rule e="way" k="natural" v="bay|strait|fjord">
        <area fill="#ADC9DD"/>
    </rule>
    <rule e="way" k="waterway" v="riverbank">
        <area fill="#B3D2E6"/>
    </rule>
    <rule e="way" k="waterway" v="river" zoom-min="10" zoom-max="12">
        <line stroke="#B3D2E6" stroke-width="1.5"/>
    </rule>
    <rule e="way" k="waterway" v="river" zoom-min="13">
        <line stroke="#B3D2E6" stroke-width="2.5"/>
        <pathText k="name" font-style="italic" font-size="1" fill="#4A6A8A" stroke="#FFFFFF" stroke-width="1.5" repeat-gap="300" priority="5"/>
    </rule>
    <rule e="way" k="waterway" v="stream|canal" zoom-min="13">
        <line stroke="#B3D2E6" stroke-width="1.8"/>
    </rule>
    <rule e="way" k="waterway" v="drain|ditch" zoom-min="15">
        <line stroke="#B3D2E6" stroke-width="1.2"/>
    </rule>
    <rule e="way" k="natural" v="wetland">
        <area fill="#D1E3D8"/>
    </rule>

    <!-- ========================================================================== -->
    <!--                              URBAN AREA                                  -->
    <!-- ========================================================================== -->

    <rule e="way" k="landuse" v="residential">
        <area fill="#DED9D1"/>
    </rule>
    <rule e="way" k="landuse" v="commercial|retail">
        <area fill="#E8DDD4"/>
    </rule>
    <rule e="way" k="landuse" v="industrial">
        <area fill="#D9D4CC"/>
    </rule>
    <rule e="way" k="landuse" v="construction">
        <area fill="#C9C3BB"/>
    </rule>

    <!-- ========================================================================== -->
    <!--                              RECREATIVE AREA                              -->
    <!-- ========================================================================== -->

    <rule e="way" k="leisure" v="park|garden">
        <area fill="#C5DDC0"/>
    </rule>
    <rule e="way" k="leisure" v="pitch|sports_centre|stadium">
        <area fill="#B8D6AE"/>
    </rule>
    <rule e="way" k="leisure" v="golf_course">
        <area fill="#B5D3A8"/>
    </rule>
    <rule e="way" k="leisure" v="playground">
        <area fill="#D0E2C8"/>
    </rule>
    <rule e="way" k="landuse" v="cemetery">
        <area fill="#D6E4D0"/>
    </rule>

    <!-- ========================================================================== -->
    <!--            STREET             -->
    <!-- ========================================================================== -->

    <!-- HIGHWAY -->
    <rule e="way" k="highway" v="motorway|motorway_link" zoom-min="8" zoom-max="10">
        <line stroke="#E19DB0" stroke-width="1.8"/>
    </rule>
    <rule e="way" k="highway" v="motorway" zoom-min="11" zoom-max="13">
        <line stroke="#C47A8C" stroke-width="4.0"/>
        <line stroke="#E89DAC" stroke-width="3.0"/>
        <pathText k="ref" font-style="bold" font-size="1" fill="#000000" stroke="#FFFFFF" stroke-width="1.5" repeat-gap="180" priority="1" display="always"/>
    </rule>
    <rule e="way" k="highway" v="motorway_link" zoom-min="11" zoom-max="13">
        <line stroke="#C47A8C" stroke-width="3.0"/>
        <line stroke="#E89DAC" stroke-width="2.0"/>
    </rule>
    <rule e="way" k="highway" v="motorway" zoom-min="14">
        <line stroke="#C47A8C" stroke-width="6.5"/>
        <line stroke="#E89DAC" stroke-width="5.0"/>
        <pathText k="ref" font-style="bold" font-size="1" fill="#000000" stroke="#FFFFFF" stroke-width="1.5" repeat-gap="180" priority="1" display="always"/>
    </rule>
    <rule e="way" k="highway" v="motorway_link" zoom-min="14">
        <line stroke="#C47A8C" stroke-width="4.5"/>
        <line stroke="#E89DAC" stroke-width="3.0"/>
    </rule>

    <!-- PRINCIPAL -->
    <rule e="way" k="highway" v="trunk|trunk_link" zoom-min="9" zoom-max="10">
        <line stroke="#F5C4A8" stroke-width="1.5"/>
    </rule>
    <rule e="way" k="highway" v="trunk|trunk_link" zoom-min="11" zoom-max="13">
        <line stroke="#D99E7F" stroke-width="3.5"/>
        <line stroke="#F5C4A8" stroke-width="2.5"/>
        <pathText k="name" font-size="1" fill="#664C00" stroke="#FFFFFF" stroke-width="1.5" repeat-gap="200" priority="2"/>
    </rule>
    <rule e="way" k="highway" v="trunk|trunk_link" zoom-min="14">
        <line stroke="#D99E7F" stroke-width="6.0"/>
        <line stroke="#F5C4A8" stroke-width="4.5"/>
        <pathText k="name" font-size="1" fill="#664C00" stroke="#FFFFFF" stroke-width="1.5" repeat-gap="200" priority="2"/>
    </rule>

    <!-- PRIMARY -->
    <rule e="way" k="highway" v="primary|primary_link" zoom-min="10" zoom-max="11">
        <line stroke="#F5D9A8" stroke-width="1.2"/>
    </rule>
    <rule e="way" k="highway" v="primary|primary_link" zoom-min="12" zoom-max="13">
        <line stroke="#D9BC8C" stroke-width="3.0"/>
        <line stroke="#F5D9A8" stroke-width="2.0"/>
        <pathText k="name" font-size="1" fill="#664C00" stroke="#FFFFFF" stroke-width="1.5" repeat-gap="220" priority="3"/>
    </rule>
    <rule e="way" k="highway" v="primary|primary_link" zoom-min="14">
        <line stroke="#D9BC8C" stroke-width="5.0"/>
        <line stroke="#F5D9A8" stroke-width="4.0"/>
        <pathText k="name" font-size="1" fill="#664C00" stroke="#FFFFFF" stroke-width="1.5" repeat-gap="220" priority="3"/>
    </rule>

    <!-- SECONDARY -->
    <rule e="way" k="highway" v="secondary|secondary_link" zoom-min="13" zoom-max="13">
        <line stroke="#D9CE9F" stroke-width="2.5"/>
        <line stroke="#F5EABC" stroke-width="1.5"/>
    </rule>
    <rule e="way" k="highway" v="secondary|secondary_link" zoom-min="14">
        <line stroke="#D9CE9F" stroke-width="4.5"/>
        <line stroke="#F5EABC" stroke-width="3.5"/>
        <pathText k="name" font-size="1" fill="#595236" stroke="#FFFFFF" stroke-width="1.5" repeat-gap="250" priority="4"/>
    </rule>

    <!-- TERTIARY -->
    <rule e="way" k="highway" v="tertiary|tertiary_link" zoom-min="14" zoom-max="15">
        <line stroke="#CCCCCC" stroke-width="2.2"/>
        <line stroke="#FAFAFA" stroke-width="1.5"/>
        <pathText k="name" font-size="1" fill="#404040" stroke="#FFFFFF" stroke-width="1.5" repeat-gap="260" priority="5"/>
    </rule>
    <rule e="way" k="highway" v="tertiary|tertiary_link" zoom-min="16">
        <line stroke="#CCCCCC" stroke-width="4.0"/>
        <line stroke="#FAFAFA" stroke-width="3.0"/>
        <pathText k="name" font-size="1" fill="#404040" stroke="#FFFFFF" stroke-width="1.5" repeat-gap="260" priority="5"/>
    </rule>

    <!-- RESIDENTIAL AND NOT CLASSIFIED -->
    <rule e="way" k="highway" v="unclassified|residential" zoom-min="16">
        <line stroke="#BBBBBB" stroke-width="3.5"/>
        <line stroke="#F5F5F5" stroke-width="2.8"/>
        <pathText k="name" font-size="1" fill="#555555" stroke="#FFFFFF" stroke-width="1.5" repeat-gap="280" priority="6"/>
    </rule>

    <!-- OTHERS -->
    <rule e="way" k="highway" v="living_street" zoom-min="15">
        <line stroke="#BBBBBB" stroke-width="1.8"/>
        <line stroke="#F0F0F0" stroke-width="1.2"/>
        <pathText k="name" font-size="1" fill="#555555" stroke="#FFFFFF" stroke-width="1.5" repeat-gap="300" priority="7"/>
    </rule>

    <rule e="way" k="highway" v="service" zoom-min="17">
        <line stroke="#BBBBBB" stroke-width="2.5"/>
        <line stroke="#ECECEC" stroke-width="2.0"/>
        <pathText k="name" font-size="1" fill="#666666" stroke="#FFFFFF" stroke-width="1.5" repeat-gap="320" priority="8"/>
    </rule>

    <rule e="way" k="highway" v="track" zoom-min="14">
        <line stroke="#B89878" stroke-width="1.2" stroke-dasharray="6,3"/>
    </rule>
    <rule e="way" k="highway" v="path|footway|cycleway" zoom-min="15">
        <line stroke="#997755" stroke-width="1.0" stroke-dasharray="4,4"/>
    </rule>
    <rule e="way" k="highway" v="pedestrian" zoom-min="14">
        <area fill="#E8E4DB"/>
        <line stroke="#C8C4BB" stroke-width="0.5"/>
    </rule>

    <!-- ========================================================================== -->
    <!--                              ESTATE                                      -->
    <!-- ========================================================================== -->

    <rule e="way" k="building" v="*" zoom-min="15" zoom-max="16">
        <area fill="#D5CFCA"/>
    </rule>
    <rule e="way" k="building" v="*" zoom-min="17">
        <area fill="#D5CFCA" stroke="#B5AFA8" stroke-width="0.5"/>
    </rule>

    <!-- ========================================================================== -->
    <!--                              RAILWAY                                     -->
    <!-- ========================================================================== -->

    <rule e="way" k="railway" v="rail" zoom-min="11" zoom-max="13">
        <line stroke="#8A8A8A" stroke-width="1.2"/>
    </rule>
    <rule e="way" k="railway" v="rail" zoom-min="14">
        <line stroke="#8A8A8A" stroke-width="1.8"/>
        <line stroke="#E8E8E8" stroke-width="0.9" stroke-dasharray="3,4"/>
    </rule>
    <rule e="way" k="railway" v="subway" zoom-min="15">
        <line stroke="#555555" stroke-width="1.0" stroke-dasharray="4,4"/>
    </rule>

    <!-- ========================================================================== -->
    <!--            NAMES                   -->
    <!-- ========================================================================== -->

    <rule e="node" k="place" v="city" zoom-min="8" zoom-max="10">
        <caption k="name" font-style="bold" font-size="3" fill="#000000" stroke="#FFFFFF" stroke-width="1.5" priority="1"/>
    </rule>
    <rule e="node" k="place" v="city" zoom-min="11">
        <caption k="name" font-style="bold" font-size="3" fill="#000000" stroke="#FFFFFF" stroke-width="2.0" priority="1"/>
    </rule>

    <rule e="node" k="place" v="town" zoom-min="10" zoom-max="12">
        <caption k="name" font-style="bold" font-size="2" fill="#333333" stroke="#FFFFFF" stroke-width="1.5" priority="2"/>
    </rule>
    <rule e="node" k="place" v="town" zoom-min="13">
        <caption k="name" font-style="bold" font-size="2" fill="#333333" stroke="#FFFFFF" stroke-width="1.5" priority="2"/>
    </rule>

    <rule e="node" k="place" v="village" zoom-min="12" zoom-max="14">
        <caption k="name" font-size="2" fill="#444444" stroke="#FFFFFF" stroke-width="1.5" priority="3"/>
    </rule>
    <rule e="node" k="place" v="village" zoom-min="15">
        <caption k="name" font-size="2" fill="#444444" stroke="#FFFFFF" stroke-width="1.5" priority="3"/>
    </rule>

    <rule e="node" k="place" v="hamlet|suburb|locality" zoom-min="14">
        <caption k="name" font-size="1" fill="#555555" stroke="#FFFFFF" stroke-width="1.5" priority="4"/>
    </rule>

    <!-- ========================================================================== -->
    <!--                         POINT OF INTEREST                          -->
    <!-- ========================================================================== -->

    <rule e="node" k="amenity" v="hospital" zoom-min="15">
        <symbol
            id="hospital-icon"
            src="file:/symbols/hospital.svg"
            symbol-width="24"
            symbol-height="24"
            symbol-percent="100" />
        <caption k="name" font-size="1" fill="#444444" dy="15"/>
    </rule>

    <rule e="node" k="amenity" v="parking" zoom-min="16">
        <symbol
            id="parking-icon"
            src="file:/symbols/parking.svg"
            symbol-width="22"
            symbol-height="22"
            symbol-percent="100" />
    </rule>

</rendertheme>