<?xml version="1.0" encoding="UTF-8"?>
<rendertheme xmlns="http://mapsforge.org/renderTheme"
    version="5"
    map-background="#D0E7F9"
    map-background-outside="#E5E5E5"
    base-stroke-width="1.0"
    base-text-size="12.0">

    <!-- Autostrade -->
    <rule e="way" k="highway" v="motorway">
        <line stroke="#FF0000" stroke-width="3.0"/>
    </rule>

    <!-- Strade principali -->
    <rule e="way" k="highway" v="primary">
        <line stroke="#FFA500" stroke-width="2.5"/>
    </rule>

    <!-- Strade secondarie -->
    <rule e="way" k="highway" v="secondary">
        <line stroke="#FFFF00" stroke-width="1.5"/>
    </rule>

    <!-- Strade locali -->
    <rule e="way" k="highway" v="residential">
        <line stroke="#FFFFFF" stroke-width="1.2"/>
    </rule>

    <!-- Acqua: laghi, mari -->
    <rule e="way" k="natural" v="water">
        <line stroke="#0000FF" stroke-width="1.5"/>
        <area fill="#A0C8F0"/>
    </rule>

    <!-- Fiumi e torrenti -->
    <rule e="way" k="waterway" v="river|stream">
        <line stroke="#0000FF" stroke-width="1.2"/>
    </rule>

    <!-- Foreste -->
    <rule e="way" k="landuse" v="forest">
        <area fill="#A0E0A0"/>
    </rule>

    <!-- Montagne / Cime -->
    <rule e="node" k="natural" v="peak">
        <symbol id="peak_symbol" src="jar:symbols/peak.svg"/>
    </rule>

    <!-- Curve di livello principali -->
    <rule e="way" k="contour_ext" v="elevation_major">
        <line stroke="#AA8855" stroke-width="0.4"/>
    </rule>

    <!-- Curve intermedie -->
    <rule e="way" k="contour_ext" v="elevation_medium">
        <line stroke="#BB9966" stroke-width="0.3" stroke-dasharray="2,4"/>
    </rule>

    <!-- Curve minori -->
    <rule e="way" k="contour_ext" v="elevation_minor">
        <line stroke="#CCAA88" stroke-width="0.2" stroke-dasharray="1,4"/>
    </rule>

    <!-- Sentieri escursionistici -->
    <rule e="way" k="highway" v="path|footway">
        <line stroke="#996633" stroke-width="0.9" stroke-dasharray="4,4"/>
    </rule>

    <!-- Tracce forestali / sterrati -->
    <rule e="way" k="highway" v="track">
        <line stroke="#996633" stroke-width="1.0" stroke-dasharray="6,4"/>
    </rule>

    <!-- Sentieri escursionistici per difficoltà (sac_scale) -->
    <rule e="way" k="sac_scale" v="hiking">
        <line stroke="#008000" stroke-width="1.0" stroke-dasharray="4,4"/>
    </rule>
    <rule e="way" k="sac_scale" v="mountain_hiking">
        <line stroke="#0066CC" stroke-width="1.0" stroke-dasharray="4,4"/>
    </rule>
    <rule e="way" k="sac_scale" v="demanding_mountain_hiking">
        <line stroke="#CC6600" stroke-width="1.2" stroke-dasharray="3,3"/>
    </rule>
    <rule e="way" k="sac_scale" v="alpine_hiking|demanding_alpine_hiking|difficult_alpine_hiking">
        <line stroke="#CC0000" stroke-width="1.3" stroke-dasharray="2,3"/>
    </rule>

</rendertheme>
